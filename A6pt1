
#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8080
#define SIZE 1024

int main()
{
    int sockfd;
    struct sockaddr_in server, client;
    socklen_t client_len;
    char buffer[SIZE];
    char result[SIZE];
    ssize_t n;
    int i;

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0) {
        perror("Socket creation failed");
        return 1;
    }

    memset(&server, 0, sizeof(server));
    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(PORT);

    if (bind(sockfd, (struct sockaddr *)&server,
             sizeof(server)) < 0) {
        perror("Bind failed");
        close(sockfd);
        return 1;
    }

    printf("UDP Server listening on port %d...\n", PORT);

    while (1) {
        client_len = sizeof(client);

        n = recvfrom(sockfd, buffer, SIZE - 1, 0,
                     (struct sockaddr *)&client, &client_len);

        if (n < 0) {
            perror("Receive failed");
            continue;
        }

        buffer[n] = '\0';

        if (n == 0)
            continue;

        char operation = buffer[0];

        if (operation == '0') {
            strcpy(result, "Client session ended");
            sendto(sockfd, result, strlen(result), 0,
                   (struct sockaddr *)&client, client_len);
            continue;
        }

        memmove(buffer, buffer + 1, strlen(buffer));

        if (operation == '1') {
            for (i = 0; buffer[i] != '\0'; i++) {
                result[i] = (char)tolower(
                    (unsigned char)buffer[i]);
            }
            result[i] = '\0';
            printf("Lowercase result: %s\n", result);
        }
        else if (operation == '2') {
            int len = strlen(buffer);

            for (i = 0; i < len; i++) {
                result[i] = buffer[len - 1 - i];
            }
            result[len] = '\0';
            printf("Reversed result: %s\n", result);
        }
        else {
            strcpy(result, "Invalid operation");
        }

        sendto(sockfd, result, strlen(result), 0,
               (struct sockaddr *)&client, client_len);
    }

    close(sockfd);
    return 0;
}


//CLIENT SIDE


#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8080
#define SIZE 1024

int main()
{
    int sockfd;
    struct sockaddr_in server;
    socklen_t server_len = sizeof(server);
    char buffer[SIZE];
    char operation;

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0) {
        perror("Socket creation failed");
        return 1;
    }

    memset(&server, 0, sizeof(server));
    server.sin_family = AF_INET;
    server.sin_port = htons(PORT);

    if (inet_pton(AF_INET, "127.0.0.1",
                  &server.sin_addr) != 1) {
        printf("Invalid server address\n");
        close(sockfd);
        return 1;
    }

    printf("Connected to UDP server address.\n");

    while (1) {
        printf("\n1. Uppercase to Lowercase\n");
        printf("2. Reverse a String\n");
        printf("0. Exit\n");
        printf("Enter choice: ");

        if (scanf(" %c", &operation) != 1)
            break;

        if (operation == '0') {
            buffer[0] = '0';
            buffer[1] = '\0';

            sendto(sockfd, buffer, 1, 0,
                   (struct sockaddr *)&server, server_len);

            ssize_t n = recvfrom(sockfd, buffer, SIZE - 1, 0,
                                 NULL, NULL);

            if (n > 0) {
                buffer[n] = '\0';
                printf("%s\n", buffer);
            }
            break;
        }

        if (operation != '1' && operation != '2') {
            printf("Invalid choice. Try again.\n");
            continue;
        }

        printf("Enter a string: ");

        if (fgets(buffer + 1, SIZE - 1, stdin) == NULL)
            break;

        buffer[strcspn(buffer + 1, "\n") + 1] = '\0';
        buffer[0] = operation;

        size_t len = strlen(buffer);

        if (sendto(sockfd, buffer, len, 0,
                   (struct sockaddr *)&server, server_len) < 0) {
            perror("Send failed");
            continue;
        }

        ssize_t n = recvfrom(sockfd, buffer, SIZE - 1, 0,
                             NULL, NULL);

        if (n < 0) {
            perror("Receive failed");
            continue;
        }

        buffer[n] = '\0';
        printf("Server response: %s\n", buffer);
    }

    close(sockfd);
    printf("Client closed.\n");
    return 0;
}
