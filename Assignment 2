#include <iostream>
#include <bitset>
using namespace std;

int main() {
    int message;

    cout << "Enter a 4-bit message (0-15): ";
    cin >> message;

    // Extract 4 data bits
    int d1 = (message >> 3) & 1;
    int d2 = (message >> 2) & 1;
    int d3 = (message >> 1) & 1;
    int d4 = message & 1;

    // Calculate parity bits
    int p1 = d1 ^ d2 ^ d4; // positions 1,3,5,7
    int p2 = d1 ^ d3 ^ d4; // positions 2,3,6,7
    int p4 = d2 ^ d3 ^ d4; // positions 4,5,6,7

    // Construct 7-bit Hamming code
    // Position: 1 2 3 4 5 6 7
    // Bit:      p1 p2 d1 p4 d2 d3 d4

    int hamming = (p1 << 6) |
                  (p2 << 5) |
                  (d1 << 4) |
                  (p4 << 3) |
                  (d2 << 2) |
                  (d3 << 1) |
                  d4;

    cout << "7-bit Hamming code: "
         << bitset<7>(hamming) << endl;

    cout << "Decimal: " << hamming << endl;

    // ---------------- DECODING ----------------

    cout << "\n--- Decoding ---" << endl;

    // Extract bits from received Hamming code
    int p1_rx = (hamming >> 6) & 1;
    int p2_rx = (hamming >> 5) & 1;
    int d1_rx = (hamming >> 4) & 1;
    int p4_rx = (hamming >> 3) & 1;
    int d2_rx = (hamming >> 2) & 1;
    int d3_rx = (hamming >> 1) & 1;
    int d4_rx = hamming & 1;

    // Calculate syndrome bits
    int s1 = p1_rx ^ d1_rx ^ d2_rx ^ d4_rx;
    int s2 = p2_rx ^ d1_rx ^ d3_rx ^ d4_rx;
    int s4 = p4_rx ^ d2_rx ^ d3_rx ^ d4_rx;

    // Calculate error position
    int error_pos = (s4 << 2) | (s2 << 1) | s1;

    if (error_pos == 0) {
        cout << "No error detected" << endl;

        cout << "Decoded message: "
             << d1_rx << d2_rx << d3_rx << d4_rx
             << endl;

        cout << "Decimal: "
             << ((d1_rx << 3) |
                 (d2_rx << 2) |
                 (d3_rx << 1) |
                 d4_rx)
             << endl;
    }
    else {
        cout << "Error detected at position: "
             << error_pos << endl;
    }

    return 0;
}
