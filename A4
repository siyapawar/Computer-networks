
#include <stdio.h>

#define MAX 20
#define INF 999

int main()
{
    int n, cost[MAX][MAX];
    int dist[MAX][MAX], nextHop[MAX][MAX];
    int newDist[MAX][MAX], newNextHop[MAX][MAX];
    int i, j, k, changed, iteration;
    int src, dest, current, steps;

    printf("Enter number of routers: ");
    scanf("%d", &n);

    if (n < 2 || n > MAX) {
        printf("Invalid number of routers.\n");
        return 1;
    }

    printf("Enter cost matrix (use %d for no direct link):\n", INF);

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    for (i = 0; i < n; i++) {
        cost[i][i] = 0;

        for (j = 0; j < n; j++) {
            dist[i][j] = cost[i][j];

            if (i == j)
                nextHop[i][j] = i;
            else if (cost[i][j] < INF)
                nextHop[i][j] = j;
            else
                nextHop[i][j] = -1;
        }
    }

    printf("\nInitial Routing Tables:\n");

    for (i = 0; i < n; i++) {
        printf("\nRouter R%d\n", i);
        printf("Destination\tCost\tNext Hop\n");

        for (j = 0; j < n; j++) {
            printf("R%d\t\t", j);

            if (dist[i][j] >= INF)
                printf("INF\t");
            else
                printf("%d\t", dist[i][j]);

            if (nextHop[i][j] == -1)
                printf("-\n");
            else
                printf("R%d\n", nextHop[i][j]);
        }
    }

    iteration = 0;

    do {
        changed = 0;

        for (i = 0; i < n; i++) {
            for (j = 0; j < n; j++) {
                newDist[i][j] = dist[i][j];
                newNextHop[i][j] = nextHop[i][j];
            }
        }

        for (i = 0; i < n; i++) {
            for (j = 0; j < n; j++) {
                for (k = 0; k < n; k++) {
                    if (cost[i][k] < INF && dist[k][j] < INF) {
                        int newCost = cost[i][k] + dist[k][j];

                        if (newCost < newDist[i][j]) {
                            newDist[i][j] = newCost;

                            if (i == k)
                                newNextHop[i][j] = j;
                            else
                                newNextHop[i][j] = nextHop[i][k];

                            changed = 1;
                        }
                    }
                }
            }
        }

        for (i = 0; i < n; i++) {
            for (j = 0; j < n; j++) {
                dist[i][j] = newDist[i][j];
                nextHop[i][j] = newNextHop[i][j];
            }
        }

        iteration++;

    } while (changed && iteration < n);

    printf("\nFinal Routing Tables:\n");

    for (i = 0; i < n; i++) {
        printf("\nRouter R%d\n", i);
        printf("Destination\tCost\tNext Hop\n");

        for (j = 0; j < n; j++) {
            printf("R%d\t\t", j);

            if (dist[i][j] >= INF)
                printf("INF\t");
            else
                printf("%d\t", dist[i][j]);

            if (nextHop[i][j] == -1)
                printf("-\n");
            else
                printf("R%d\n", nextHop[i][j]);
        }
    }

    printf("\nEnter source router (0 to %d): ", n - 1);
    scanf("%d", &src);

    printf("Enter destination router (0 to %d): ", n - 1);
    scanf("%d", &dest);

    if (src < 0 || src >= n || dest < 0 || dest >= n) {
        printf("Invalid router number.\n");
        return 1;
    }

    if (dist[src][dest] >= INF) {
        printf("No path exists between R%d and R%d.\n",
               src, dest);
        return 0;
    }

    printf("\nShortest path: R%d", src);

    current = src;
    steps = 0;

    while (current != dest && steps < n) {
        current = nextHop[current][dest];

        if (current == -1) {
            printf("\nPath unavailable.\n");
            return 1;
        }

        printf(" -> R%d", current);
        steps++;
    }

    printf("\nMinimum cost: %d\n", dist[src][dest]);

    return 0;
}
